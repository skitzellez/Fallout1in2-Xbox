<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="GamerDad.Fallout1in2" Publisher="CN=GamerDad" Version="0.1.0.9" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Fallout 1in2 for Xbox</DisplayName>
    <PublisherDisplayName>Skitzelles</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="fallout2-ce.exe" EntryPoint="Fallout1in2.App">
      <uap:VisualElements DisplayName="Fallout 1in2 for Xbox" Description="Fallout 1 on the Fallout 2 Community Edition engine, for Xbox Dev Mode"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="#101008">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101008" />
      </uap:VisualElements>
      <Extensions>
        <!-- Game Vault starts the game with fallout1in2: -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fallout1in2" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="broadFileSystemAccess" />
    <rescap:Capability Name="expandedResources" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
