<Window x:Class="Fallout1in2Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fallout 1in2 for Xbox - Setup" Width="760" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Back}" Icon="icon.png">
  <Border Margin="18" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="6" Background="{StaticResource Panel}">
    <StackPanel Margin="26,22">
      <StackPanel Orientation="Horizontal">
        <Image Source="icon.png" Width="56" Height="56" Margin="0,0,16,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FALLOUT 1in2 FOR XBOX" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="Makes a USB drive that plays Fallout 1 on your Xbox" Foreground="{StaticResource Dim}" />
        </StackPanel>
      </StackPanel>

      <Rectangle Height="1.5" Fill="{StaticResource Line}" Margin="0,18,0,14" />

      <TextBlock Text="1.  YOUR GAMES" FontWeight="Bold" Margin="0,0,0,8" />
      <Grid Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Fo1Mark" Grid.Row="0" Text="?" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fallout" VerticalAlignment="Center" />
        <TextBlock x:Name="Fo1Path" Grid.Row="0" Grid.Column="2" Text="looking..." Foreground="{StaticResource Dim}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
        <Button Grid.Row="0" Grid.Column="3" Content="Change" Style="{StaticResource PipButton}" Click="PickFo1" Margin="0,3" />
        <TextBlock x:Name="Fo2Mark" Grid.Row="1" Text="?" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Fallout 2" VerticalAlignment="Center" />
        <TextBlock x:Name="Fo2Path" Grid.Row="1" Grid.Column="2" Text="looking..." Foreground="{StaticResource Dim}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
        <Button Grid.Row="1" Grid.Column="3" Content="Change" Style="{StaticResource PipButton}" Click="PickFo2" Margin="0,3" />
      </Grid>
      <TextBlock Text="You need both games (Steam, GOG or Epic). Fallout 1 is played inside Fallout 2's engine."
                 Foreground="{StaticResource Dim}" FontSize="13" Margin="16,6,0,0" TextWrapping="Wrap" />

      <TextBlock Text="2.  YOUR USB DRIVE" FontWeight="Bold" Margin="0,18,0,8" />
      <Grid Margin="16,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="Drives" SelectionChanged="DriveChanged" />
        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource PipButton}" Click="RefreshDrives" Margin="10,0,0,0" />
      </Grid>
      <TextBlock x:Name="DriveNote" Text="" Foreground="{StaticResource Dim}" FontSize="13" Margin="16,6,0,0" TextWrapping="Wrap" />

      <TextBlock Text="3.  EXTRAS" FontWeight="Bold" Margin="0,18,0,6" />
      <StackPanel Margin="16,0,0,0">
        <CheckBox x:Name="HqMusic" IsChecked="True"
                  Content="High-quality music  (the soundtrack remastered, ~390 MB download)" />
        <CheckBox x:Name="Details" IsChecked="True"
                  Content="Extra details  (footprints, animated force fields, new Vault 15 entrance)" />
        <CheckBox x:Name="Robodog" IsChecked="False" Content="Robodog  (Dogmeat becomes a robot dog, just for fun)" />
      </StackPanel>

      <Rectangle Height="1.5" Fill="{StaticResource Line}" Margin="0,18,0,16" />

      <Button x:Name="Go" Content="MAKE MY USB DRIVE" Style="{StaticResource PipButton}" FontSize="20" FontWeight="Bold"
              Padding="20,12" Click="MakeDrive" />
      <ProgressBar x:Name="Bar" Height="10" Margin="0,16,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource Green}"
                   Background="#0B120B" BorderBrush="{StaticResource Line}" Visibility="Collapsed" />
      <TextBlock x:Name="Status" Text="" Margin="0,10,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

      <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center">
        Fallout 1in2 (Fallout et tu) by the Rotators team, Fallout 2 Community Edition by Alexander Batalov and contributors,
        HQ music by BGforge. Downloaded from their own GitHub pages while you set up. Fallout is a trademark of Bethesda Softworks;
        this free fan project is not made or endorsed by them. You need your own copies of the games.
      </TextBlock>
    </StackPanel>
  </Border>
</Window>
